CONSUMERGRAPH_CATALOG_MODE=demo
CONSUMERGRAPH_MODE=demo
# DATAHUB_MCP_URL=https://your-tenant.acryl.io/integrations/ai/mcp/
# DATAHUB_MCP_TOKEN=replace-with-service-account-token
# DATAHUB_SOURCE_URN=urn:li:dataset:(urn:li:dataPlatform:snowflake,analytics.customer_360,PROD)
DATAHUB_GMS_URL=http://localhost:8080
DATAHUB_GMS_TOKEN=
# Optional real GitHub Issues delivery for review-approved Change Campaign tasks.
# Use a fine-grained token limited to the target repository with Issues: write.
CONSUMERGRAPH_GITHUB_REPOSITORY=owner/repository
CONSUMERGRAPH_GITHUB_TOKEN=
# Optional comma-separated labels that already exist in the target repository.
CONSUMERGRAPH_GITHUB_LABELS=
